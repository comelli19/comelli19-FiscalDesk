# Port configuration (defaults to 3000)
PORT="3000"

# Server Authentication Token for POST/PUT/DELETE and Gemini routes
API_AUTH_TOKEN="fiscaldesk-internal-token-2026"
VITE_API_AUTH_TOKEN="fiscaldesk-internal-token-2026"

# Gemini Model for XML diagnosis & legislation search (optional, defaults to gemini-2.5-flash on Vercel)
GEMINI_MODEL="gemini-2.5-flash"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Vercel Project Settings > Environment Variables or AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
